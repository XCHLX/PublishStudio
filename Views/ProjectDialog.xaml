<Window x:Class="PublishStudio.Views.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目设置" Width="660" Height="700" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" Background="White" ResizeMode="CanResize">

    <Window.Resources>
        <!-- 多行输入框：全局模板是单行用的，这里换成可滚动的多行宿主。 -->
        <Style x:Key="MultiLineBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Padding="2,4" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
            <StackPanel>

                <TextBlock Text="项目名称" Style="{StaticResource LabelText}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,14" />

                <TextBlock Text="项目目录" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" />
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                            Click="BrowsePath_Click" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="项目类型" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="TypeBox" Height="32" VerticalContentAlignment="Center"
                                  SelectionChanged="TypeBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="VariantLabel" Text="环境（仅 .NET 生效）" Style="{StaticResource LabelText}" />
                        <!-- 按项目类型切换内容：Api / Custom 显示环境，Node.js 显示 nvm 里的 node 版本 -->
                        <ComboBox x:Name="VariantBox" Height="32" VerticalContentAlignment="Center"
                                  ToolTip=".NET 项目选运行环境；Node.js 项目填 node 版本（18 / 18.20 / 18.20.8 都行，留空用系统默认）" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="分组（自定义分类，可直接输入新名字新建一个）"
                           Style="{StaticResource LabelText}" />
                <ComboBox x:Name="GroupBox" Height="32" VerticalContentAlignment="Center"
                          IsEditable="True" Margin="0,0,0,4"
                          ToolTip="留空表示未分组；输入一个还没出现过的名字就是新建分组" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="分组只影响列表的「分组」列、筛选下拉和托盘一级菜单。列表里每个分组有自己的色点，颜色按名字自动分配。" />

                <TextBlock Text="内务府发布 ID（发布打包时用，留空则只能编译；保存时会校验）"
                           Style="{StaticResource LabelText}" />
                <TextBox x:Name="ReleaseIdBox" Margin="0,0,0,14" />

                <CheckBox x:Name="AutoGitPullBox" Content="发布前自动 git pull" FontSize="13"
                          VerticalContentAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="勾选后每次「发布」会先在项目目录执行 git pull，拉取失败（有冲突、要账号密码、不是 git 仓库）就中断，不会用旧代码打包。只编译不执行。" />

                <TextBlock Text="构建命令" Style="{StaticResource LabelText}" />
                <TextBox x:Name="BuildCommandBox" Margin="0,0,0,4" />
                <TextBlock x:Name="BuildHint" Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <TextBlock Text="运行命令（右键「运行」时用，在系统控制台窗口里执行）"
                           Style="{StaticResource LabelText}" />
                <TextBox x:Name="RunCommandBox" Margin="0,0,0,4" />
                <TextBlock x:Name="RunHint" Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <TextBlock Text="后置命令（编译成功后按顺序执行，一行一条，失败即中断）"
                           Style="{StaticResource LabelText}" />
                <TextBox x:Name="PostCommandsBox" Style="{StaticResource MultiLineBox}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="支持占位符 {work} 项目目录、{output} 产物目录、{folder} 目录名、{stamp} 时间戳。可用 # 开头写注释。" />
                <TextBlock Text="产物目录" Style="{StaticResource LabelText}" />

                <TextBox x:Name="OutputDirBox" Grid.Column="0" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
           Text="新建时默认填 %TEMP%\PublishStudio\build\{folder}-{stamp}，每次发布各落一个临时目录。清空则自动推断：.NET 用临时目录，Node.js 用项目下的 dist。支持占位符 {folder} 目录名、{stamp} 时间戳、{work} 项目目录。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="24,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="88"
                        Click="Cancel_Click" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Width="88"
                        Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>