<Window x:Class="PublishStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发布工具" Height="500" Width="900" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ========== 菜单栏 ========== -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Menu VerticalAlignment="Center">
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="新建项目" InputGestureText="Ctrl+N" Click="NewProject_Click" />
                </MenuItem>
                <MenuItem Header="设置(_S)">
                    <MenuItem Header="发布配置" Click="PublishSettings_Click" />
                </MenuItem>
                <MenuItem Header="帮助(_H)">
                    <MenuItem Header="打开配置文件夹" Click="ShowProjectConfig_Click" />
                    <MenuItem Header="打开临时文件夹" Click="ShowTempFolder_Click" />
                    <MenuItem Header="打开日志文件夹" Click="ShowLogFolder_Click" />
                    <Separator />
                    <MenuItem Header="关于" Click="MenuAbout_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ========== 工具栏 ========== -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索" FontSize="15"  VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                    <TextBox x:Name="SearchBox" Width="210" TextChanged="SearchBox_TextChanged"
                             ToolTip="按名称、路径或分组名搜索" />
                    <ComboBox x:Name="TypeFilter" Width="110" Height="32" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="TypeFilter_SelectionChanged" />
                    <ComboBox x:Name="ReleaseFilter" Width="96" Height="32" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="ReleaseFilter_SelectionChanged"
                              ToolTip="按发布环境筛选（正式 / 测试），没查到发布信息的算测试" />
                    <ComboBox x:Name="GroupFilter" Width="110" Height="32" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="GroupFilter_SelectionChanged"
                              ToolTip="按自定义分组筛选；分组候选来自现有项目，可在「编辑项目」里输入新分组名" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LoginButton" Content="登录" Style="{StaticResource PrimaryButton}"
                            Click="Login_Click" ToolTip="点击切换登录账号" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 项目列表 ========== -->
        <Grid Grid.Row="2">
            <ListView x:Name="ProjectList" Background="White" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Loaded="ProjectList_Loaded"
                      SizeChanged="ProjectList_SizeChanged"
                      MouseDoubleClick="ProjectList_MouseDoubleClick"
                      KeyDown="ProjectList_KeyDown">
                <ListView.View>
                    <GridView>
                        <!-- 前两列的内容可能很长，统一用省略号截断，悬停可看全名 -->
                        <GridViewColumn x:Name="NameColumn" Header="项目名称" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn x:Name="ReleaseNameColumn" Header="发布名称" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReleaseName}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding ReleaseName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- 分组：只靠文字颜色区分（未分组统一灰），不放色点 -->
                        <GridViewColumn x:Name="GroupColumn" Header="分组" Width="88">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GroupText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding GroupColorHex}"
                                               ToolTip="{Binding GroupName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ReleaseEnvColumn" Header="发布环境" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReleaseEnvironment}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DevelopmentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReleaseEnvironment}" Value="正式">
                                                        <Setter Property="Foreground" Value="{StaticResource ProductionBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReleaseEnvironment}" Value="测试">
                                                        <Setter Property="Foreground" Value="{StaticResource TestBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="StatusColumn" Header="状态" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 文字带耗时（成功 · 83s），颜色仍按 Status 上色 -->
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="成功">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="失败">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="编译中">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="发布中">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- 上次发布时间：只记「发布」成功，编译 / git pull 不算。没发过是空串，排序时沉底 -->
                        <GridViewColumn x:Name="LastReleaseColumn" Header="上次发布时间" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastReleaseText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               ToolTip="{Binding LastReleaseFullText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="TypeColumn" Header="类型" Width="80" DisplayMemberBinding="{Binding Type}" />

                        <!-- 空白占位列：吃掉前两列贴内容之后剩下的宽度，表头才不会在右边断掉。
                             必须给一个空模板，否则 GridView 会把整行对象（PublishStudio.Models.Project）画出来 -->
                        <GridViewColumn x:Name="FillerColumn" Width="0">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu x:Name="ItemMenu" Opened="ItemMenu_Opened">
                        <MenuItem Header="运行" Click="MenuRun_Click" />
                        <MenuItem Header="发布" Click="MenuRelease_Click" />
                        <MenuItem Header="编译" Click="MenuBuild_Click" />

                        <Separator />
                        <MenuItem Header="git pull" Click="MenuGitPull_Click" />
                        <MenuItem Header="用 VS Code 打开" Click="MenuVsCode_Click" />
                        <MenuItem Header="打开目录" Click="MenuOpenFolder_Click" />
                        <MenuItem Header="复制目录路径" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="查询发布信息" Click="MenuQueryRelease_Click" />
                        <MenuItem Header="打开发布记录页面" Click="MenuOpenReleasePage_Click" />
                        <Separator />
                        <MenuItem Header="编辑…" Click="MenuEdit_Click" />
                        <MenuItem Header="移除" Click="MenuRemove_Click" />
                        <Separator />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <TextBlock x:Name="EmptyHint" IsHitTestVisible="False" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Text="还没有项目，按 Ctrl+N 或菜单「文件 → 新建项目」开始" />
        </Grid>

        <!-- ========== 状态栏 ========== -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="StatusBarText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="关闭窗口会最小化到托盘，从托盘菜单退出" FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>