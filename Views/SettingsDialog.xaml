<Window x:Class="PublishStudio.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置发布配置" Width="600" Height="690" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" Background="White" ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
            <StackPanel>

                <TextBlock Text="接口地址" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiUrlBox" Grid.Column="0" />
                    <TextBox x:Name="ApiUrlPlainBox" Grid.Column="0" Visibility="Collapsed" />
                    <Button x:Name="ApiUrlToggle" Grid.Column="1" Content="显示" Width="64"
                            Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                            Click="ToggleApiUrl_Click" />
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="后端接口根地址，例如 https://api.example.com" />

                <TextBlock Text="网页地址" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="WebUrlBox" Grid.Column="0" />
                    <TextBox x:Name="WebUrlPlainBox" Grid.Column="0" Visibility="Collapsed" />
                    <Button x:Name="WebUrlToggle" Grid.Column="1" Content="显示" Width="64"
                            Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                            Click="ToggleWebUrl_Click" />
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="前端页面根地址，例如 https://www.example.com" />

                <TextBlock Text="OSS Key" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="OssKeyBox" Grid.Column="0" />
                    <TextBox x:Name="OssKeyPlainBox" Grid.Column="0" Visibility="Collapsed" />
                    <Button x:Name="OssKeyToggle" Grid.Column="1" Content="显示" Width="64"
                            Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                            Click="ToggleOssKey_Click" />
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="对象存储的 AccessKeyId" />

                <TextBlock Text="OSS 密钥" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="OssSecretBox" Grid.Column="0" />
                    <TextBox x:Name="OssSecretPlainBox" Grid.Column="0" Visibility="Collapsed" />
                    <Button x:Name="OssSecretToggle" Grid.Column="1" Content="显示" Width="64"
                            Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                            Click="ToggleOssSecret_Click" />
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="对象存储的 AccessKeySecret" />

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,18">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="上面四项都加密保存在 settings.json 里（Windows 系统级加密，只有本机当前账户能解开），界面上默认打码，点右侧「显示」才看得到明文。换电脑或换 Windows 账户后凭据解不开，需要在这里重填一次。" />
                </Border>

                <TextBlock Text="保留历史发布文件" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="KeepDaysBox" Height="32" Margin="0,0,0,4"
                          VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="%TEMP%\PublishStudio\build 里超过这个天数的临时目录会被删掉；选「不保留」就只留最近 1 小时内还在用的目录" />

                <TextBlock Text="双击项目列表时触发" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="DoubleClickBox" Height="32" Margin="0,0,0,4"
                          VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="运行 = 控制台里跑开发命令；发布 = 编译打包上传后再调内务府接口；编译 = 只编译。默认运行。" />

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="导出备份…" Style="{StaticResource GhostButton}" Width="96"
                            Margin="0,0,10,0" Click="Export_Click"
                            ToolTip="把这 6 项配置用口令加密存成 .psbak，换电脑时用「导入备份…」恢复" />
                    <Button Content="导入备份…" Style="{StaticResource GhostButton}" Width="96"
                            Click="Import_Click"
                            ToolTip="从 .psbak 恢复配置，会覆盖当前这 6 项" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Width="88"
                            Click="Cancel_Click" Margin="0,0,10,0" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="88" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
