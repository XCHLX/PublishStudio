<Window x:Class="PublishStudio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 发布工具" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" Background="White"
        ShowInTaskbar="False">

    <StackPanel>

        <!-- ========== 标题区 ========== -->
        <StackPanel Orientation="Horizontal" Margin="28,26,28,0">
            <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                <TextBlock Text="发" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="发布工具" FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <!-- Text 由后台按程序集版本填写（见 AboutWindow.xaml.cs），这里只是设计期占位，别在 XAML 里写死版本号。
                         点击版本号打开 GitHub 发布页：查到新版本时直接打开那个版本，否则打开发布列表。 -->
                    <TextBlock x:Name="VersionText" Text="V" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                               ToolTip="打开 GitHub 发布页" MouseLeftButtonUp="VersionText_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="· 编译 / 打包 / 上传 / 回调，一条流水线" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="28,20,28,0" />

        <!-- ========== 基本信息 ========== -->
        <ItemsControl x:Name="InfoList" Margin="28,18,28,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Label}" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 版本检测：打开窗口自动查一次，也可以点底部「检查更新」重查。查不到只显示一行提示，不影响其它内容。
             颜色由后台 SetStatus 决定：有新版是红色（含「去下载」），已最新是绿色，其余是灰色。 -->
        <StackPanel Orientation="Horizontal" Margin="28,2,28,0">
            <TextBlock x:Name="UpdateText" Text="正在检查更新…" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdateLink" Text="去下载" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0"
                       Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                       VerticalAlignment="Center" Visibility="Collapsed"
                       MouseLeftButtonUp="UpdateLink_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="FooterHint" Margin="28,8,28,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="配置和数据都保存在本机，不会上传。settings.json 是明文 JSON（含 OSS 密钥），别把这个文件发给别人。" />

        <!-- ========== 按钮区 ========== -->
        <Border Height="64" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="28,0">
                <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource GhostButton}"
                        Width="96" Click="Check_Click" Margin="0,0,10,0" />
                <Button x:Name="CopyButton" Content="复制信息" Style="{StaticResource GhostButton}"
                        Width="96" Click="Copy_Click" Margin="0,0,10,0" />
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="88" Click="Close_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
